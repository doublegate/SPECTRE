# EditorConfig for SPECTRE
# https://editorconfig.org

root = true

# Default for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Rust files
[*.rs]
indent_size = 4
max_line_length = 100

# TOML files
[*.toml]
indent_size = 4

# YAML files
[*.{yml,yaml}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = 120

# Shell scripts
[*.sh]
indent_size = 2

# TypeScript/JavaScript (for GUI)
[*.{ts,tsx,js,jsx}]
indent_size = 2
max_line_length = 100

# CSS
[*.{css,scss}]
indent_size = 2

# HTML
[*.html]
indent_size = 2

# Makefiles (require tabs)
[Makefile]
indent_style = tab
indent_size = 4

# Git files
[.git*]
indent_size = 4
